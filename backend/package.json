{
  "name": "script-pdf-maker-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "serve": "bun run --watch dev-server.ts",
    "build": "bun build ./functions/generate-pdf.ts --outdir ./api --target bun",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sparticuz/chromium": "^143.0.4",
    "botc-character-sheet": "workspace:*",
    "botc-script-checker": "0.2.5",
    "jszip": "^3.10.2",
    "preact": "^10.19.3",
    "preact-render-to-string": "^6.4.0",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.11.19",
    "@vercel/node": "^3.0.21",
    "puppeteer": "^25.16.0",
    "typescript": "^5.3.3",
    "vercel": "^48.6.0",
    "vitest": "^5.0.5"
  }
}
